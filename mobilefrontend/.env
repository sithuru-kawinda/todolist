# Mobile API URL — pick the line that matches your setup and comment out the rest
#
# Android emulator (built-in alias for the host machine):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
#
# Physical Android/iOS device — must be on the same WiFi as this PC:
EXPO_PUBLIC_API_URL=http://192.168.1.8:4000
#
# iOS simulator (same machine as dev server):
# EXPO_PUBLIC_API_URL=http://localhost:4000
